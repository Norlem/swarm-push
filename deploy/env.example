# /etc/swarm-push.env — copy to fleet-manager EC2, fill in real values
PORT=5200
RELAY_URL=https://relay.swarm.bdev.norlem.com
RELAY_AGENT_KEY=<agent-key-for-swarm-push-identity>
VAPID_PUBLIC_KEY=<generate with: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(JSON.stringify(k))">
VAPID_PRIVATE_KEY=<see above>
VAPID_SUBJECT=mailto:bnorman@norlemtc.com
OPERATOR_ID=session-primary
SUBSCRIPTIONS_FILE=/opt/swarm-push-data/subscriptions.json
CONSOLE_ORIGIN=https://console.swarm.bdev.norlem.com
